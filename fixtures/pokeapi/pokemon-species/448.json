        "name": "es",
        "url": "https://pokeapi.co/api/v2/language/7/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "https://pokeapi.co/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Lucario reads its opponent’s feelings with its\naura waves. It finds out things it would rather\nnot know, so it gets stressed out easily.",
