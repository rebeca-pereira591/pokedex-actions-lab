        "name": "en",
        "url": "https://pokeapi.co/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-moon",
        "url": "https://pokeapi.co/api/v2/version/30/"
      }
    },
    {
      "flavor_text": "Caza a sus presas manipulando una energía,\ndenominada aura, cuya potencia es capaz incluso\nde hacer añicos rocas enormes.",
