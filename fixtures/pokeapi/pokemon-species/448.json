        "name": "en",
        "url": "https://pokeapi.co/api/v2/language/9/"
      },
      "version": {
        "name": "ultra-sun",
        "url": "https://pokeapi.co/api/v2/version/29/"
      }
    },
    {
      "flavor_text": "Puede percibir sentimientos ajenos a través de\nsu aura, pero averiguar cosas que preferiría no\nsaber constituye una fuente de estrés para él.",
