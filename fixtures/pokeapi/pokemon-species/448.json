        "name": "en",
        "url": "https://pokeapi.co/api/v2/language/9/"
      },
      "version": {
        "name": "sword",
        "url": "https://pokeapi.co/api/v2/version/33/"
      }
    },
    {
      "flavor_text": "Puede leer los pensamientos de la gente, por\nlo que establece lazos afectivos únicamente con\nEntrenadores de corazón noble.",
